# Heroku supplies PORT. Never commit a populated .env file.
DATABASE_URL=
DATABASE_SSL=true

# Must exactly match the main site's worker authentication and callback HMAC values.
WORKER_API_KEY=
CALLBACK_HMAC_SECRET=

# Bakong registration values. The worker uses the registered email to renew its token.
BAKONG_REGISTERED_EMAIL=
BAKONG_ACCESS_TOKEN=
BAKONG_API_BASE_URL=https://api-bakong.nbc.gov.kh
BAKONG_TOKEN_RENEW_INTERVAL_MS=3000000

# Operational limits. Polling must remain between 3 and 15 seconds.
POLL_INTERVAL_MS=3500
CALLBACK_RETRY_BASE_MS=5000
MAX_CALLBACK_ATTEMPTS=8
MAX_ACTIVE_WATCHES=500
